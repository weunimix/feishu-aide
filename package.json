{
  "name": "feishu-aide",
  "version": "0.2.1",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "DSH 插件：在会话中读取飞书文档、wiki 与消息，并把修改写回飞书。",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pack:check": "node scripts/check-pack.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm typecheck && pnpm test:unit && pnpm test:policy",
    "test:unit": "tsx --test \"test/**/*.test.ts\"",
    "test:policy": "node --test scripts/prune-merged-branches.test.mjs scripts/check-secrets.test.mjs scripts/check-docs.test.mjs scripts/check-pr-title.test.mjs scripts/check-repo-settings.test.mjs scripts/check-branch-name.test.mjs scripts/label-pr-size.test.mjs scripts/check-pack.test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:map": "node scripts/check-docs.mjs --write",
    "docs:impact": "node scripts/doc-impact.mjs",
    "title:check": "node scripts/check-pr-title.mjs",
    "branch:check": "node scripts/check-branch-name.mjs",
    "size:label": "node scripts/label-pr-size.mjs",
    "repo:audit": "node scripts/check-repo-settings.mjs",
    "repo:audit:write": "node scripts/check-repo-settings.mjs --write",
    "check": "pnpm check:secrets && pnpm docs:check && pnpm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weunimix/feishu-aide.git"
  }
}
