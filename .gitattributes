# The repository is developed on Windows and verified on Linux CI. Keep LF in
# scripts, workflows and docs so a CRLF checkout cannot break a shebang or YAML.
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
# 许可证全文按原样保存：CRLF 会让逐字比对上游文本时出现无意义的差异。
LICENSE text eol=lf
